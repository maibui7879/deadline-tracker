{
  "name": "deadline-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Student Deadline Tracker — Ứng dụng quản lý deadline bài tập cá nhân",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "json-server db.json --port 3001",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\""
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.5.1",
    "axios": "^1.7.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "json-server": "^1.0.0-beta.3",
    "tailwindcss": "^4.1.5",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
